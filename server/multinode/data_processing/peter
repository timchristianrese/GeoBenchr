from __future__ import annotations
import gzip
import io
import pathlib
import re
import shutil
import zipfile
import xml.etree.ElementTree as ET
from collections import defaultdict
from datetime import datetime

import numpy as np
import polars as pl
import requests

# ---------------- CONFIG ----------------

BASE_BUCKET = "http://aisdata.ais.dk.s3.eu-central-1.amazonaws.com"
PREFIXES = ["2024/", "2025/"]

OUT_DIR = pathlib.Path("output")
TMP_DIR = pathlib.Path("tmp")

(OUT_DIR / "crossing_points").mkdir(parents=True, exist_ok=True)
(OUT_DIR / "crossings").mkdir(parents=True, exist_ok=True)
TMP_DIR.mkdir(exist_ok=True)

# ---------------- FILTER PARAMS ----------------

SOG_THRESHOLD = 1.0
STOP_TIME_MINUTES = 20
MAX_TIME_GAP_MINUTES = 60

# EPSG:4326 bounding box (Danish waters)

X_MIN, X_MAX = 1.34, 18.78
Y_MIN, Y_MAX = 52.37, 60.49

# ---------------- S3 LISTING ----------------

def list_zip_files(prefix: str) -> list[str]:
	url = f"{BASE_BUCKET}/?list-type=2&prefix={prefix}"
	r = requests.get(url)
	r.raise_for_status()

	root = ET.fromstring(r.text)
	ns = {"s3": "http://s3.amazonaws.com/doc/2006-03-01/"}

	files = []
	for c in root.findall("s3:Contents", ns):
		key = c.find("s3:Key", ns).text
		if key.endswith(".zip"):
			files.append(f"{BASE_BUCKET}/{key}")

	return files


def month_from_key(key: str) -> str | None:
	m = re.search(r"aisdk-(\d{4}-\d{2})-\d{2}", key)
	return m.group(1) if m else None

def group_zips_by_month() -> dict[str, list[str]]:
	buckets = defaultdict(list)


	for prefix in PREFIXES:
		for url in list_zip_files(prefix):
			key = url.split("/")[-1]
			month = month_from_key(key)
			if month:
				buckets[month].append(url)

	return buckets


# ---------------- TRIP LOGIC ----------------

def assign_crossing_ids(mmsi_arr, ts_arr, sog_arr, suffix):
	n = len(mmsi_arr)
	out = np.zeros(n, dtype=np.int64)
	if n == 0:
		return out


	ts_int = ts_arr.astype("datetime64[ns]").astype(np.int64)

	gap = np.empty(n)
	gap[0] = np.nan
	gap[1:] = (ts_int[1:] - ts_int[:-1]) / 6e10

	new_ship = np.empty(n, dtype=bool)
	new_ship[0] = True
	new_ship[1:] = mmsi_arr[1:] != mmsi_arr[:-1]
	gap[new_ship] = np.nan

	moving = sog_arr > SOG_THRESHOLD

	trip_id = 0
	current = 0
	in_trip = False

	for i in range(n):
		if new_ship[i]:
			in_trip = False

		g = gap[i]

		if not np.isnan(g) and g > MAX_TIME_GAP_MINUTES:
			in_trip = False

		if not in_trip and moving[i]:
			trip_id += 1
			current = int(f"{trip_id}{suffix}")
			in_trip = True

		if in_trip and not moving[i]:
			if not np.isnan(g) and g >= STOP_TIME_MINUTES:
				in_trip = False

		if in_trip:
			out[i] = current

	return out


# ---------------- PROCESS ONE FILE ----------------

def process_csv_gz(path: pathlib.Path):
	df = pl.read_csv(
	path,
	columns=["# Timestamp", "MMSI", "Latitude", "Longitude", "SOG"],
	schema_overrides={"MMSI": pl.Int64, "SOG": pl.Float64},
	try_parse_dates=False,
	)


	df = (
		df.with_columns(
			pl.col("# Timestamp")
			.str.strptime(pl.Datetime("ns"), "%d/%m/%Y %H:%M:%S", strict=False)
			.alias("Timestamp")
		)
		.drop("# Timestamp")
		.sort(["MMSI", "Timestamp", "SOG", "Latitude", "Longitude"])
		.unique(subset=["MMSI", "Timestamp"], keep="last", maintain_order=True)
	)

	suffix = "000000"  # not critical for grouping logic here

	crossing_ids = assign_crossing_ids(
		df["MMSI"].to_numpy(),
		df["Timestamp"].to_numpy(),
		df["SOG"].to_numpy(),
		suffix,
	)

	df = df.with_columns(pl.Series("crossing_id", crossing_ids)).with_columns(
		pl.col("crossing_id").cast(pl.UInt64),
		pl.col("Timestamp").dt.epoch("s").cast(pl.UInt32).alias("t"),
		pl.col("Longitude").cast(pl.Float64).alias("x"),
		pl.col("Latitude").cast(pl.Float64).alias("y"),
	).filter(
		pl.col("x").is_between(X_MIN, X_MAX)
		& pl.col("y").is_between(Y_MIN, Y_MAX)
	)

	df_points = df.select("crossing_id", "t", "x", "y").unique().sort("t")

	df_crossings = (
		df.filter(pl.col("crossing_id") != 0)
		.group_by("crossing_id", maintain_order=True)
		.agg(
			pl.col("t").first().alias("t0"),
			pl.col("t").last().alias("t1"),
			pl.col("MMSI").first().alias("MMSI"),
			pl.col("x").first().alias("x0"),
			pl.col("y").first().alias("y0"),
			pl.col("x").last().alias("x1"),
			pl.col("y").last().alias("y1"),
		)
	)

	return df_points, df_crossings


# ---------------- PARQUET WRITE ----------------

def append_parquet(df: pl.DataFrame, path: pathlib.Path):
    if path.exists():
        existing = pl.read_parquet(path)
        df = pl.concat([existing, df], how="vertical")

    path.parent.mkdir(parents=True, exist_ok=True)
    df.write_parquet(path, compression="snappy")

# ---------------- ZIP STREAM PROCESSING ----------------

def process_zip(url: str):
	print(f"Downloading: {url}")


	r = requests.get(url)
	r.raise_for_status()

	with zipfile.ZipFile(io.BytesIO(r.content)) as z:
		for name in z.namelist():
			if not name.endswith(".csv"):
				continue

			print(f"Processing {name}")

			gz_path = TMP_DIR / (pathlib.Path(name).stem + ".csv.gz")

			with z.open(name) as f_in, gzip.open(gz_path, "wb") as f_out:
				shutil.copyfileobj(f_in, f_out)

			df_pts, df_crs = process_csv_gz(gz_path)

			month = re.search(r"(\d{4}-\d{2})", name).group(1)

			append_parquet(df_pts, OUT_DIR / "crossing_points" / f"aisdk-{month}.parquet")
			append_parquet(df_crs, OUT_DIR / "crossings" / f"aisdk-{month}.parquet")

			gz_path.unlink()


# ---------------- MAIN PIPELINE ----------------

def main():
	month_buckets = group_zips_by_month()

	print(f"Found {len(month_buckets)} months")

	for month, urls in sorted(month_buckets.items()):
		print(f"\n=== MONTH {month} ({len(urls)} files) ===")

		for url in urls:
			try:
				process_zip(url)
			except Exception as e:
				print(f"FAILED {url}: {e}")


if __name__ == "__main__":
	main()

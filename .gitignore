/geobenchr-paper/*
#ignore all terraform files in the repository, also in all subfolders

*.tfstate
*.tfstate.backup
*.tfvars
*.tfplan
*.tfout
.terraform/*
# ignore all .terraform directories in the repository
**/.terraform/
#.DS_Store files are created by macOS and should be ignored
.DS_Store
mobilitydb/docker/

# build artifacts / caches that shouldn't be committed
**/target/
__pycache__/
*.pyc
.idea/
data_generator_cycling/venv/

# internal partner-cluster access notes (IPs, usernames, paths) - not for publication
benchmark/client/benchmark_client/docs/spacetime-cluster-access.md

# Generator/data-processing OUTPUT (downloaded or regenerated by the scripts alongside them --
# some of these trees run into tens of GB, well past what git or GitHub's 100MB-per-file limit
# can hold). The dummy_sample.parquet exceptions below are small, intentionally-committed
# stand-ins for real data (see ais_sample_parquet_file / cycling_sample_parquet_file /
# geolife_sample_parquet_file in server/multinode/ansible/inventory/*/group_vars/all/all.yml),
# so they stay tracked even though the directories around them are ignored.
data_generator_ais/output_data/*
!data_generator_ais/output_data/crossing_points/
data_generator_ais/output_data/crossing_points/*
!data_generator_ais/output_data/crossing_points/dummy_sample.parquet

data_generator_aviation/generated/
data_generator_aviation/parquet_flights/
data_generator_aviation/process_data/flights_txt/

data_generator_cycling/berlin_bike.graphml
data_generator_cycling/graph/cache/
data_generator_cycling/output/*
!data_generator_cycling/output/parquet/
data_generator_cycling/output/parquet/*
!data_generator_cycling/output/parquet/dummy_sample.parquet
data_generator_cycling/data/all/
data_generator_cycling/data/output/
data_generator_cycling/data/processed/
data_generator_cycling/data/raw_trips/
data_generator_cycling/data/training/

data_generator_geolife/cache/
data_generator_geolife/synthetic_output/*
!data_generator_geolife/synthetic_output/dummy_sample.parquet

server/multinode/data_processing/data/
server/multinode/data_processing/tmp/

# ad-hoc benchmark run logs dumped directly under logs/ (logs/old/ and logs/paper/ are curated
# result sets and stay tracked)
logs/*.log

# generated benchmark config output (regenerated by combineYaml.py / generateParameterVariations.py)
/output/

# accidental local copies from a botched remote-copy command -- directories literally named
# after an scp/rsync destination spec (tim@<host>), duplicating data_generator_aviation content
# (~1.6GB total across the three). Left in place on disk, just never tracked.
old/tim@*/

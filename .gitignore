/geobenchr-paper/*
#ignore all terraform files in the repository, also in all subfolders

*.tfstate
*.tfstate.backup
*.tfvars
*.tfplan
*.tfout
.terraform/*
# ignore all .terraform directories in the repository
**/.terraform/
#.DS_Store files are created by macOS and should be ignored
.DS_Store
mobilitydb/docker/

# build artifacts / caches that shouldn't be committed
**/target/
__pycache__/
*.pyc
.idea/
data_generators/cycling/venv/

# internal partner-cluster access notes (IPs, usernames, paths) - not for publication
benchmark/client/benchmark_client/docs/spacetime-cluster-access.md

# correspondence drafts with the SpaceTime team - not for publication
benchmark/client/benchmark_client/docs/reply-ante-*.md

# raw client stdout of benchmark runs (archives of ~60 MB each, mostly printed result rows; the
# per-query logs under raw/logs/ are what build_results.py reads)
benchmark/results/**/raw/stdout/

# verified sample-query notes per SUT - embeds cluster-internal hostnames/ports, same reason as
# spacetime-cluster-access.md above; not for publication
benchmark/client/benchmark_client/docs/sample-queries.md

# Generator/data-processing OUTPUT (downloaded or regenerated by the scripts alongside them --
# some of these trees run into tens of GB, well past what git or GitHub's 100MB-per-file limit
# can hold). The dummy_sample.parquet exceptions below are small, intentionally-committed
# stand-ins for real data (see ais_sample_parquet_file / cycling_sample_parquet_file /
# geolife_sample_parquet_file in server/multinode/ansible/inventory/*/group_vars/all/all.yml),
# so they stay tracked even though the directories around them are ignored.
data_generators/ais/output_data/*
!data_generators/ais/output_data/crossing_points/
data_generators/ais/output_data/crossing_points/*
!data_generators/ais/output_data/crossing_points/dummy_sample.parquet

data_generators/aviation/generated/
data_generators/aviation/parquet_flights/
data_generators/aviation/process_data/flights_txt/

data_generators/cycling/berlin_bike.graphml
data_generators/cycling/graph/cache/
data_generators/cycling/output/*
!data_generators/cycling/output/parquet/
data_generators/cycling/output/parquet/*
!data_generators/cycling/output/parquet/dummy_sample.parquet
data_generators/cycling/data/all/
data_generators/cycling/data/output/
data_generators/cycling/data/processed/
data_generators/cycling/data/raw_trips/
data_generators/cycling/data/training/

data_generators/geolife/cache/
data_generators/geolife/synthetic_output/*
!data_generators/geolife/synthetic_output/dummy_sample.parquet

server/multinode/data_processing/data/
server/multinode/data_processing/tmp/

# ad-hoc benchmark run logs dumped directly under logs/ (logs/old/ and logs/paper/ are curated
# result sets and stay tracked)
logs/*.log

# generated benchmark config output (regenerated by combineYaml.py / generateParameterVariations.py)
/output/

# single-node (paper-era) material and code no longer used, moved out of the tracked tree on 2026-10-10
# and kept only locally: single-node/paper/ (what the single-node paper used), single-node/unused/
# (code and copies nothing uses any more). See single-node/README.md.
/single-node/

# accidental local copies from a botched remote-copy command -- directories literally named
# after an scp/rsync destination spec (tim@<host>), duplicating data_generators/aviation content
# (~1.6GB total across the three). Left in place on disk, just never tracked.
old/tim@*/
